# =============================================================================
# Backend API Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# Anthropic API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model configurations
ANTHROPIC_HAIKU_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_SONNET_MODEL=claude-3-7-sonnet-20250219

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# For local development, use: redis://localhost:6379
# For production (Railway/Upstash), use the provided URL
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development | staging | production
ENVIRONMENT=development

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# File Upload Settings
# -----------------------------------------------------------------------------
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# -----------------------------------------------------------------------------
# Virus Scanning (Optional)
# -----------------------------------------------------------------------------
# Leave empty to use NoOp scanner
# Set to ClamAV API URL if available
VIRUS_SCAN_URL=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Requests per minute per user
RATE_LIMIT_PER_MINUTE=60

# Burst allowance
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
# Model for generating embeddings
EMBEDDING_MODEL=voyage-3

# Embedding dimension (must match vector column size)
EMBEDDING_DIMENSION=1536

# -----------------------------------------------------------------------------
# Worker Configuration (RQ)
# -----------------------------------------------------------------------------
# Number of worker processes
WORKER_CONCURRENCY=2

# Job timeout in seconds
JOB_TIMEOUT=300

# Result TTL in seconds (how long to keep job results)
RESULT_TTL=3600

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: json | text
LOG_FORMAT=json

# Enable request logging
LOG_REQUESTS=true

# -----------------------------------------------------------------------------
# Sentry Configuration (Error Tracking)
# -----------------------------------------------------------------------------
# Get your DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=

# Sample rate for performance monitoring (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sample rate for profiling (0.0 to 1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Cost Tracking
# -----------------------------------------------------------------------------
# Enable LLM cost logging
ENABLE_COST_TRACKING=true

# Cost tracking aggregation level: call | user | day
COST_TRACKING_LEVEL=call

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable OCR for scanned PDFs (not implemented in MVP)
ENABLE_OCR=false

# Enable Truth Guard fact verification
ENABLE_TRUTH_GUARD=true

# Enable ATS scoring
ENABLE_ATS_SCORING=true

# Enable JD matching
ENABLE_JD_MATCHING=true

# Enable optimization suggestions
ENABLE_OPTIMIZATION=true

# -----------------------------------------------------------------------------
# Database Connection (Optional - Supabase handles this)
# -----------------------------------------------------------------------------
# Only needed if connecting directly to Postgres
# DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Enable detailed health check response
HEALTH_CHECK_DETAILED=false

# Health check timeout in seconds
HEALTH_CHECK_TIMEOUT=5
