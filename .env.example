# Supabase (cloud project — required for Auth + Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend (copy to apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (copy to apps/api/.env or repo root .env)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5-20250929
VIRUS_SCAN_URL=

# Anthropic (required for Step 2 parse jobs)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Optional virus scanner HTTP endpoint. If unset, intake uses NoOpVirusScanner (TODO swap).
# VIRUS_SCAN_URL=http://localhost:3310/scan

